# Public browser configuration. These values are included in the compiled app.
VITE_API_ORIGIN=https://localhost:7249
# Optional future media delivery boundary; never a storage/disk path.
VITE_MEDIA_ORIGIN=
# Owner/deployment must explicitly supply the business currency before release.
VITE_BUSINESS_CURRENCY=EGP

# Server-only paths to trusted localhost PEM files outside this repository.
# Configure these in .env.local or the process environment, never with VITE_.
BROUJ_HTTPS_CERT_FILE=
BROUJ_HTTPS_KEY_FILE=

# Homepage submission paths on VITE_API_ORIGIN. An explicitly blank path closes that form.
# Registration sends { name, phone, inquiry }; the existing Brouj contact endpoint accepts this payload.
VITE_HOME_REGISTRATION_PATH=/api/v1/contact-submissions
# Survey sends { priority, clarity, suggestion } and expects the standard Brouj success envelope.
VITE_HOME_SURVEY_PATH=
# Editorial status lists, comma-separated regular-project GUIDs from the catalogue.
VITE_HOME_CURRENT_PROJECT_IDS=
VITE_HOME_PREVIOUS_PROJECT_IDS=
# Published videos on a permitted media origin. Blank values use labeled local architectural previews.
VITE_HOME_INITIATIVE_FILM=
VITE_HOME_QUALITY_FILM=
VITE_HOME_EXPANSION_FILM=
