# Public browser configuration. These values are included in the compiled app.
VITE_API_ORIGIN=https://localhost:7249
# Optional future media delivery boundary; never a storage/disk path.
VITE_MEDIA_ORIGIN=
# Owner/deployment must explicitly supply the business currency before release.
VITE_BUSINESS_CURRENCY=EGP

# Server-only paths to trusted localhost PEM files outside this repository.
# Configure these in .env.local or the process environment, never with VITE_.
BROUJ_HTTPS_CERT_FILE=
BROUJ_HTTPS_KEY_FILE=
